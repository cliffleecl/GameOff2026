{
  "name": "brain-shift",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Brain Shift — 會學習的殭屍 × 跑酷逃生（Game Jam 主題：Shift）",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "sim": "node sim/sim.mjs",
    "zip": "vite build && node scripts/zip-itch.mjs",
    "itch": "vite build && node scripts/push-itch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "lil-gui": "^0.19.2",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "archiver": "^7.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
